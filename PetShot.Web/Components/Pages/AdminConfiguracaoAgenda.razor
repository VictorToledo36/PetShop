@page "/admin/configuracao-agenda"
@rendermode InteractiveServer
@inject IAgendaService AgendaService
@using Microsoft.AspNetCore.Authorization
@using PetShop.Application.Interfaces
@using PetShop.Domain.Entities
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Configurar Agenda - Admin</PageTitle>

<div class="container-fluid py-4" style="padding-top: 90px !important; min-height: calc(100vh - 200px);">
    <div class="container" style="max-width: 900px;">
        <div class="mb-4">
            <h3 class="fw-bold mb-0" style="color: #6a0dad;">🛠️ Configurar Agenda</h3>
            <p class="text-muted small mb-0">Defina os dias, horários e bloqueios disponíveis para agendamento</p>
        </div>

        @if (!string.IsNullOrEmpty(mensagem))
        {
            <div class="alert @(sucesso ? "alert-success" : "alert-danger") alert-dismissible">
                @mensagem
                <button type="button" class="btn-close" @onclick="() => mensagem = null"></button>
            </div>
        }

        @if (carregando)
        {
            <div class="text-center py-5">
                <div class="spinner-border" style="color: #6a0dad;" role="status"></div>
            </div>
        }
        else
        {
            <!-- CONFIGURAÇÕES GERAIS -->
            <div class="card border-0 shadow mb-4" style="border-radius: 16px;">
                <div class="card-header text-white fw-bold py-3"
                     style="background-color: #6a0dad; border-radius: 16px 16px 0 0;">
                    ⚙️ Configurações Gerais
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Duração de cada horário (minutos)</label>
                            <input type="number" min="5" step="5" class="form-control" @bind="duracaoSlotMinutos" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Dias de antecedência máxima</label>
                            <input type="number" min="1" class="form-control" @bind="diasAntecedenciaMaxima" />
                            <div class="form-text">Até quantos dias no futuro o cliente pode agendar</div>
                        </div>
                    </div>
                    <button class="btn text-white fw-bold px-4 mt-3" style="background-color: #6a0dad;"
                            @onclick="SalvarConfiguracaoGeral">
                        <i class="bi bi-check-circle me-2"></i>Salvar
                    </button>
                </div>
            </div>

            <!-- HORÁRIO DE FUNCIONAMENTO -->
            <div class="card border-0 shadow mb-4" style="border-radius: 16px;">
                <div class="card-header text-white fw-bold py-3"
                     style="background-color: #6a0dad; border-radius: 16px 16px 0 0;">
                    📅 Horário de Funcionamento
                </div>
                <div class="card-body p-4">
                    @foreach (var linha in horariosForm)
                    {
                        <div class="row g-3 align-items-center py-2 border-bottom">
                            <div class="col-6 col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="linha.Ativo" id="ativo-@linha.DiaSemana" />
                                    <label class="form-check-label fw-bold" for="ativo-@linha.DiaSemana">
                                        @NomeDia(linha.DiaSemana)
                                    </label>
                                </div>
                            </div>
                            <div class="col-3 col-md-4">
                                <label class="form-label small text-muted mb-0">Início</label>
                                <input type="time" class="form-control" disabled="@(!linha.Ativo)"
                                       value="@linha.HoraInicio.ToString("HH:mm")"
                                       @onchange="e => linha.HoraInicio = TimeOnly.Parse((string)e.Value!)" />
                            </div>
                            <div class="col-3 col-md-4">
                                <label class="form-label small text-muted mb-0">Fim</label>
                                <input type="time" class="form-control" disabled="@(!linha.Ativo)"
                                       value="@linha.HoraFim.ToString("HH:mm")"
                                       @onchange="e => linha.HoraFim = TimeOnly.Parse((string)e.Value!)" />
                            </div>
                        </div>
                    }
                    <button class="btn text-white fw-bold px-4 mt-3" style="background-color: #6a0dad;"
                            @onclick="SalvarHorarios">
                        <i class="bi bi-check-circle me-2"></i>Salvar horários
                    </button>
                </div>
            </div>

            <!-- BLOQUEIOS -->
            <div class="card border-0 shadow mb-4" style="border-radius: 16px;">
                <div class="card-header text-white fw-bold py-3"
                     style="background-color: #6a0dad; border-radius: 16px 16px 0 0;">
                    🚫 Dias Bloqueados
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 align-items-end mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Data</label>
                            <input type="date" class="form-control" @bind="novoBloqueioData"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold">Motivo (opcional)</label>
                            <input class="form-control" @bind="novoBloqueioMotivo" placeholder="Ex: Feriado, manutenção..." />
                        </div>
                        <div class="col-md-3">
                            <button class="btn text-white fw-bold w-100" style="background-color: #6a0dad;"
                                    @onclick="AdicionarBloqueio">
                                <i class="bi bi-plus-circle me-2"></i>Bloquear
                            </button>
                        </div>
                    </div>

                    @if (!bloqueios.Any())
                    {
                        <p class="text-muted small mb-0">Nenhum dia bloqueado no momento.</p>
                    }
                    else
                    {
                        @foreach (var bloqueio in bloqueios)
                        {
                            <div class="d-flex justify-content-between align-items-center p-2 rounded mb-2" style="background-color: #f8f0ff;">
                                <div>
                                    <span class="fw-bold">@bloqueio.Data.ToString("dd/MM/yyyy")</span>
                                    @if (!string.IsNullOrWhiteSpace(bloqueio.Motivo))
                                    {
                                        <span class="text-muted small ms-2">— @bloqueio.Motivo</span>
                                    }
                                </div>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoverBloqueio(bloqueio.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool carregando = true;
    private string? mensagem;
    private bool sucesso;

    private int duracaoSlotMinutos;
    private int diasAntecedenciaMaxima;

    private List<HorarioFuncionamento> horariosForm = new();
    private List<BloqueioAgenda> bloqueios = new();

    private DateTime novoBloqueioData = DateTime.Today.AddDays(1);
    private string? novoBloqueioMotivo;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        carregando = true;

        var config = await AgendaService.ObterConfiguracaoAsync();
        duracaoSlotMinutos = config.DuracaoSlotMinutos;
        diasAntecedenciaMaxima = config.DiasAntecedenciaMaxima;

        var horariosExistentes = await AgendaService.ObterHorariosAsync();
        horariosForm = Enum.GetValues<DayOfWeek>().Select(dia =>
        {
            var existente = horariosExistentes.FirstOrDefault(h => h.DiaSemana == dia);
            return existente ?? new HorarioFuncionamento
            {
                DiaSemana = dia,
                HoraInicio = new TimeOnly(8, 0),
                HoraFim = new TimeOnly(18, 0),
                Ativo = false
            };
        }).ToList();

        bloqueios = await AgendaService.ObterBloqueiosAsync();

        carregando = false;
    }

    private async Task SalvarConfiguracaoGeral()
    {
        if (duracaoSlotMinutos <= 0 || diasAntecedenciaMaxima <= 0)
        {
            mensagem = "❌ Informe valores válidos.";
            sucesso = false;
            return;
        }

        await AgendaService.AtualizarConfiguracaoAsync(duracaoSlotMinutos, diasAntecedenciaMaxima);
        mensagem = "✅ Configuração salva!";
        sucesso = true;
    }

    private async Task SalvarHorarios()
    {
        if (horariosForm.Any(h => h.Ativo && h.HoraInicio >= h.HoraFim))
        {
            mensagem = "❌ O horário de início deve ser antes do horário de fim.";
            sucesso = false;
            return;
        }

        await AgendaService.SalvarHorariosAsync(horariosForm);
        mensagem = "✅ Horários salvos!";
        sucesso = true;
        await Carregar();
    }

    private async Task AdicionarBloqueio()
    {
        if (novoBloqueioData.Date < DateTime.Today)
        {
            mensagem = "❌ Escolha uma data válida.";
            sucesso = false;
            return;
        }

        if (await AgendaService.AdicionarBloqueioAsync(novoBloqueioData, novoBloqueioMotivo))
        {
            mensagem = "✅ Dia bloqueado!";
            sucesso = true;
            novoBloqueioMotivo = null;
            bloqueios = await AgendaService.ObterBloqueiosAsync();
        }
    }

    private async Task RemoverBloqueio(int id)
    {
        if (await AgendaService.RemoverBloqueioAsync(id))
        {
            mensagem = "✅ Bloqueio removido!";
            sucesso = true;
            bloqueios = await AgendaService.ObterBloqueiosAsync();
        }
    }

    private static string NomeDia(DayOfWeek dia) => dia switch
    {
        DayOfWeek.Sunday => "Domingo",
        DayOfWeek.Monday => "Segunda",
        DayOfWeek.Tuesday => "Terça",
        DayOfWeek.Wednesday => "Quarta",
        DayOfWeek.Thursday => "Quinta",
        DayOfWeek.Friday => "Sexta",
        DayOfWeek.Saturday => "Sábado",
        _ => dia.ToString()
    };
}
