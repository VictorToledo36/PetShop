@page "/admin"
@rendermode InteractiveServer
@inject IAgendamentoService AgendamentoService
@using Microsoft.AspNetCore.Authorization
@using PetShop.Application.Interfaces
@using PetShop.Domain.Enums
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Painel Admin</PageTitle>

<div class="container-fluid py-4" style="padding-top: 90px !important; min-height: calc(100vh - 200px);">
    <div class="container">
        <h3 class="fw-bold mb-4" style="color: #6a0dad;">📊 Painel Administrativo</h3>

        @if (carregando)
        {
            <div class="text-center py-5">
                <div class="spinner-border" style="color: #6a0dad;" role="status"></div>
            </div>
        }
        else
        {
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow h-100" style="border-radius: 12px;">
                        <div class="card-body p-3 text-center">
                            <div class="fs-3 fw-bold" style="color: #f0ad4e;">@pendentes</div>
                            <div class="text-muted small">⏳ Pendentes</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow h-100" style="border-radius: 12px;">
                        <div class="card-body p-3 text-center">
                            <div class="fs-3 fw-bold text-success">@confirmados</div>
                            <div class="text-muted small">✅ Confirmados</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow h-100" style="border-radius: 12px;">
                        <div class="card-body p-3 text-center">
                            <div class="fs-3 fw-bold text-info">@concluidos</div>
                            <div class="text-muted small">🏁 Concluídos</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow h-100" style="border-radius: 12px;">
                        <div class="card-body p-3 text-center">
                            <div class="fs-3 fw-bold" style="color: #6a0dad;">@total</div>
                            <div class="text-muted small">📅 Total</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3">
                <a href="/admin/agendamentos" class="btn text-white fw-bold px-4 py-3" style="background-color: #6a0dad; border-radius: 12px;">
                    <i class="bi bi-calendar-check me-2"></i>Gerenciar Agendamentos
                </a>
                <a href="/admin/servicos" class="btn btn-outline-secondary fw-bold px-4 py-3" style="border-radius: 12px;">
                    <i class="bi bi-gear me-2"></i>Gerenciar Serviços
                </a>
                <a href="/admin/configuracao-agenda" class="btn btn-outline-secondary fw-bold px-4 py-3" style="border-radius: 12px;">
                    <i class="bi bi-sliders me-2"></i>Configurar Agenda
                </a>
            </div>
        }
    </div>
</div>

@code {
    private bool carregando = true;
    private int pendentes, confirmados, concluidos, total;

    protected override async Task OnInitializedAsync()
    {
        var agendamentos = await AgendamentoService.ObterTodosAsync();
        total = agendamentos.Count;
        pendentes = agendamentos.Count(a => a.Status == StatusAgendamento.Pendente);
        confirmados = agendamentos.Count(a => a.Status == StatusAgendamento.Confirmado);
        concluidos = agendamentos.Count(a => a.Status == StatusAgendamento.Concluido);
        carregando = false;
    }
}
